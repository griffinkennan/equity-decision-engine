# API keys (all optional — the app runs on Yahoo Finance + SEC EDGAR with none
# of these set; each provider fails soft). Copy to .env and paste keys.

# Financial Modeling Prep — financialmodelingprep.com (free tier: 5y statements)
FMP_API_KEY=

# FRED (Federal Reserve) — fred.stlouisfed.org > My Account > API Keys
# Enables live macro readings (rates, CPI, credit spreads) in Macro Sensitivity.
FRED_API_KEY=

# Finnhub — finnhub.io/register (free tier)
# Enables insider transaction share counts + analyst recommendation trends.
FINNHUB_API_KEY=
